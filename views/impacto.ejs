<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <title>Rua Solidária</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="style.css" />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <style>
:root {
  --bs-body-color: #acffbf !important;
}
        </style>
    </head>

  <body>
    <header>
      <div class="header-container">
        <img
          src="LogoRuaSolidariaPNG.png"
          alt="Logo Rua Solidária"
          class="logo"
        />
        <div class="titulo">
          <h1>RUA SOLIDÁRIA</h1>
          <p>Transforme doações em esperança e dignidade!</p>
        </div>
      </div>
    </header>

    <main>
        <% if (user) { %>
            <div id="login_sign" class="fade-in">

            <a href="/"><%= user%> aaaa</a>

            <img src="/default.png" width="32" height="32" alt="Default Image" />

            </div>
        <% } else { %>

      <div id="login_sign" class="fade-in">
        <a href="#" onclick="mostrar_login(); return false;">Login</a>
        /
        <a href="#" onclick="mostrar_signin(); return false;">Sign-In</a>
      </div>
       <% } %>

    </main> 
    <main id="main">
      <section id="valores-arrecadados" class="fade-in" >
        <h1>VALORES ARRECADADOS</h1>
        <div class="impacto-container">
          <p>Total arrecadado:</p>
                    <div id="contador" class="contador">R$ <%= total_amount.toFixed(2) %></div>
                    <p> Doe agora e salve vidas </p>
        </div>
         <input class="form-control-sm" style="width: 200px; margin-bottom: 50px;" type="search" placeholder="Search..." aria-label="Search">
        <div class="flex-container">
            <%   instituicoes.forEach((i, key) => { %>
                <div class="flex-item">
                    <img src=<%=i.picture%> class="block-image"></img>
                    <p>arrecadado:</p>
                    <div id="contador" class="contador">R$ <%=i.value.toFixed(2)%></div>
                    <p> <%= i.description %> </p>
                    <a href=<%= "/perfis/instituicoes/"+ i.id + "?from=impacto"  %>>Saiba mais</a>
                </div>
            <% }); %>
        </div>
            <div class="padding"  style="margin: 20px;"><h2>Recente Doações dos usuarios:</h3></div>
        <div class="container-impacto">
            <%  for(const user_profile of users.slice().reverse()) { %>
                <div class="flex-item">
                    <img src=<%=user_profile.picture%> class="block-image"></img>
                    <h3><%= user_profile.name%></h3>
                    <p>doado:</p>
                    <div id="contador" class="contador">R$ <%= user_profile.value%></div>
                    <p> <%= user_profile.description %> </p>
                </div>
            <% } %>
        </div>
        <!-- <a href="/" class="btn btn-primary">Voltar ao inicio</a> -->
        <button onclick="voltarInicio()">Voltar ao Início</button> 
      </section>
    </main>
    
    <footer>&copy; 2025 Rua Solidária</footer>

    <!-- <script src="script.js"></script> -->

  <script>
    function fadeOut(element, href) {
      let opacity = 1;
      const interval = setInterval(() => {
        opacity -= 0.05;
        element.style.opacity = opacity;
            console.log(element.style.opacity);
        if (opacity <= 0) {
          clearInterval(interval);
          window.location.href = href;
        }
        }, 50);
    }
    const el = document.getElementById("main");
    window.addEventListener("DOMContentLoaded", () => {
      window.voltarInicio= () => {
        fadeOut(el, "/");

      };
    });
  </script>

</body>
</html>

 
