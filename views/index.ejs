<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <title>Rua Solidária</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />

    </head>
  <body>
    <link rel="stylesheet" href="style.css" />
    <header>
      <div class="header-container">
        <img
          src="LogoRuaSolidariaPNG.png"
          alt="Logo Rua Solidária"
          class="logo"
        />
        <div class="titulo">
          <h1>RUA SOLIDÁRIA</h1>
          <p>Transforme doações em esperança e dignidade!</p>
        </div>
      </div>  
            <% if (user) { %>
            <div id="login_sign" class="fade-in">

            <a href="/"><%= user%></a>

            <img src="default.png" width="32" height="32" alt="Default Image" />

            </div>
        <% } else { %>

      <div id="login_sign" class="fade-in">
        <a href="#" onclick="mostrar_login(); return false;">Login</a>
        /
        <a href="#" onclick="mostrar_signin(); return false;">Sign-In</a>
      </div>
       <% } %>
    </header>

    <main>


      <section id="conteudo" class="fade-in">
        <div class="conteudo-wrapper">
          <div class="texto-inicial">
            <p>
              <strong>Todos os dias</strong>, milhares de pessoas enfrentam a
              <span class="azul-claro">fome</span>, o
              <span class="azul-claro">frio</span> e o
              <span class="azul-claro">abandono</span>.
            </p>
            <p>
              Enquanto muitos seguem suas rotinas, outros
              <em>lutam apenas para sobreviver</em>. <strong>Doar</strong> é
              estender a mão, é dizer: <q>você importa</q>.
            </p>
            <p>
              Com um simples gesto, você leva
              <span class="azul-claro">alimento</span>,
              <span class="azul-claro">cuidado</span>,
              <span class="azul-claro">dignidade</span> e
              <span class="azul-claro">esperança</span> para quem perdeu quase
              tudo.
            </p>
            <ul>
              <li><span>➡️</span>Transforme vidas com um pequeno gesto.</li>
              <li><span>➡️</span>Doe agora e faça a diferença!</li>
            </ul>
            <p>
              <strong>Faça agora</strong>, um pequeno valor para você pode ser
              <span class="destaque">tudo</span> para alguém.
            </p>
            <div class="botoes-iniciais">
              <button onclick="mostrarDoacao()">Doar Agora</button>
              <button onclick="mostrarImpacto()">Valores Arrecadados</button>
                <% if (user){%>
                  <button onclick="mostrarImpacto()">pagina admins</button>
                <%} %>
            </div>
          </div>
          <div class="imagem-inicial">
            <img src="ImagemDoaçaoPixAnimaçao.png" alt="Doação via Pix" />
          </div>
        </div>
      </section>


    <main>
      <section id="valores-arrecadados" class="fade-in" style="display: none">
        <h1>VALORES ARRECADADOS</h1>
        <div class="impacto-container">
          <p>Total arrecadado:</p>
          <div id="contador" class="contador">R$ 0,00</div>
          <p>Distribuição por instituição:</p>
          <ul id="impactoInstituicoes">
            <li>
                <a href="perfis/instituicoes/1">Instituto Ramacrisma:</a><span id="ramacrismaTotal">R$ 0,00</span>
            </li>
            <li><a href="perfis/instituicoes/2">Pão dos Pobres:</a> <span id="paoPobresTotal">R$ 0,00</span></li>
          </ul>
        </div>
        <button onclick="voltarInicio()">Voltar ao Início</button> 
        <div class="container-impacto">
            <div class="block-container">
                <img src="/pao_dos_pobres.png"/>
                <p>arrecadado:</p>
                <div id="contador" class="contador">R$ 0,00</div>
                <p> pobre merece pao tmb </p>
            </div>
        </div>
      </section>
    </main>
      

    <main>
      <section id="sign-in-usuario" class="fade-in" style="display: none">
        <div class="container">
          <div class="auth-container">
            <h2 class="form-title">Criar Conta</h2>
            <form id="registerForm" class="login-page">
              <div class="mb-3">
                <label for="username" class="form-label">Username</label>
                <input
                  type="text"
                  class="form-control"
                  id="username"
                  name="username"
                  required
                />
              </div>

              <div class="mb-3">
                <label for="email" class="form-label">Email</label>
                <input
                  type="email"
                  class="form-control"
                  id="email"
                  name="email"
                  required
                />
              </div>

              <div class="mb-3">
                <label for="password" class="form-label">Senha</label>
                <input
                  type="password"
                  class="form-control"
                  id="password"
                  name="password"
                  minlength="8"
                  required
                />
              </div>
              <div class="mb-3">
                <label for="birthdate" class="form-label"
                  >Data de Nascimento</label
                >
                <input
                  type="date"
                  class="form-control"
                  id="birthdate"
                  name="birthdate"
                  required
                />
              </div>

              <button type="button" onclick="cadastrar()" class=" btn-custom">Cadastrar</button>

              <div class="mt-3 text-center">
                <p>
                  Já tem uma conta?
                  <a href="#" id="loginLink">é uma instituição?</a>
                </p>
              </div>
              <div class="mt-3 text-center">
                <p>
                  Já tem uma conta? <a href="#" id="loginLink">Faça login</a>
                </p>
              </div>
            </form>
          </div>
        </div>
      </section>
    </main>
    <main>
      <section id="login" class="login-page fade-in" style="display: none">
        <div class="container">
          <div class="login-container">
            <div class="text-center mb-4">
              <i
                class="bi bi-person-circle"
                style="font-size: 3rem; color: #4e73df"
              ></i>
              <h2 class="mt-2">Login</h2>
            </div>

            <form id="loginForm">
              <div class="mb-3">
                <label for="email" class="form-label">Email</label>
                <input
                  type="email"
                  class="form-control"
                  id="email_login"
                  name="email"
                  placeholder="seu@email.com"
                  required
                />
              </div>

              <div class="mb-3">
                <label for="password" class="form-label">Senha</label>
                <input
                  type="password"
                  class="form-control"
                  id="password_login"
                  name="password"
                  placeholder="••••••••"
                  required
                />
              </div>

              <div class="d-grid mb-3">
                <button onclick="login_form()" class="btn-login">
                  Entrar
                  <!-- <i class="bi bi-box-arrow-in-right me-2"></i> Entrar -->
                </button>
              </div>

              <div class="text-center">
                <a href="#" class="text-decoration-none">Esqueceu a senha?</a>
                <p class="mt-2">
                  Não tem conta?
                  <a href="cadastro.html" class="text-decoration-none"
                    >Cadastre-se</a
                  >
                </p>
              </div>
            </form>
          </div>
        </div>
      </section>
    </main>

    <footer>&copy; 2025 Rua Solidária</footer>

    <script src="script.js"></script>
  </body>
</html>

